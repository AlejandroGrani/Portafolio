---
import ExperienceItems from "./ExperienceItems.astro"

 const EXPERIENCE =[
    
    {
        date: 'Septiembre del 2023 hasta Mayo de 2024 ',
        tittle: 'Desarrollador:',
        company: 'Entersoft',
        description: 
         '•Participé activamente en el diseño y desarrollo de sistemas y herramientas que automatizaron procesos críticos para el Banco de Chile, garantizando eficiencia y precisión en la gestión de datos.  •Adquirí un dominio en tecnologías y herramientas como DataStage (para la integración y transformación de datos), Power BI (para la creación de dashboards y análisis de datos), SQL Developer (para la gestión y consulta de bases de datos), Entornos Shell (para la automatización de tareas y scripts), y Visual Studio Code (para el desarrollo y depuración de código). ',
    },
    {
        date: 'Mayo del 2020 hasta  Septiembre de 2023 ',
        tittle: 'Personal Administrativo:',
        company: 'HC Abastecimientos Integrales',
        description: 
         '•Desempeñé labores de almacenado y reposición de productos de ferretería y de primera necesidad, además el diseño de mecanismo de control de inventario, logistica y suministro',
    }
 ]
---
<ol class="relative border-s border-gray-200 dark:border-gray-700">
    
    {
        EXPERIENCE.map((experience) => (
            <li class="mb-10 ms-4"> 
                <ExperienceItems {...experience} />
            </li>
        ))
    }
   
</ol>

